<?xml version="1.0" encoding="utf-8"?>
<!-- Category header for the platform preference framework, restyled to the M3
     type scale and colour roles. Mirrors @android:layout/preference_category_material,
     which hardcodes TextAppearance.Material.Body2 and ?android:attr/colorAccent. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dip"
    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
    android:textColor="?attr/colorPrimary"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="16dip" />
